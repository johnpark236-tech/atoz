# ============================================================
# BizFlow AtoZ - Environment Variables
# Copy this file to .env and fill in values for local dev.
# NEVER commit actual secrets to Git.
# ============================================================

# --- AI Studio (existing) ---
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Supabase (Phase 2 - Database/Auth) ---
# ENV_REQUIRED: Get from Supabase project settings → API
# https://app.supabase.com/project/{YOUR_PROJECT_ID}/settings/api
VITE_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# --- Payment Gateway (Phase 5 - Billing) ---
# Option A: Toss Payments
# ENV_REQUIRED: https://developers.tosspayments.com
VITE_TOSS_CLIENT_KEY="test_ck_YOUR_TOSS_CLIENT_KEY"

# Option B: PortOne (KG이니시스/나이스)
# ENV_REQUIRED: https://portone.io
VITE_PORTONE_IMP_CODE="imp_YOUR_PORTONE_CODE"

# --- AI Backend Proxy (Phase 9 - AI Assistant) ---
# NEVER expose AI API keys in frontend code.
# All AI calls must go through your backend server.
# ENV_REQUIRED: Your backend API URL
VITE_AI_BACKEND_URL="https://api.yourdomain.com"

# --- App Configuration ---
VITE_APP_NAME="BizFlow AtoZ"
VITE_APP_VERSION="1.0.0"

# --- Email (Phase 1 - Auth / Password Reset) ---
# ENV_REQUIRED: SMTP or Supabase Auth handles email by default
# If using custom SMTP: configure in Supabase dashboard
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your@email.com"
# SMTP_PASS="your_app_password"

# --- Object Storage (Phase 7 - Document Vault) ---
# ENV_REQUIRED: Supabase Storage bucket name
VITE_STORAGE_BUCKET="bizflow-documents"

# --- Feature Flags ---
# Set to "true" to enable features not yet fully ready for production
VITE_FEATURE_AI_ASSISTANT="true"
VITE_FEATURE_DOCUMENT_VAULT="true"
VITE_FEATURE_ADMIN="true"
