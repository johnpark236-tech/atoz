# Google Apps Script Web App Deployment URL for Cloud State Persistence
VITE_GOOGLE_SHEETS_API_URL="https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec"

# Optional Market Research Live Search API endpoint
VITE_MARKET_RESEARCH_API_URL="/api/market-research"

# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
